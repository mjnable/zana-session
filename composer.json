{
    "name": "mj-zana/session",
    "description": "Server-side sessions and flash messages for Zana applications, stored in a PSR-16 cache",
    "type": "library",
    "keywords": ["zana", "session", "flash", "cookie"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/core": "^2.2",
        "mj-zana/http": "^2.2",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Session\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Session\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.3.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.3.0" } } },
        { "type": "path", "url": "../zana-http", "options": { "symlink": true, "versions": { "mj-zana/http": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
